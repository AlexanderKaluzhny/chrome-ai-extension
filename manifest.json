{
  "name": "AI Page Explorer",
  "version": "1.0",
  "manifest_version": 3,
  "action": {
    "default_title": "AI Page Explorer",
    "default_popup": "popup.html",
    "default_icon": {
      "19": "icons/icon19.png",
      "38": "icons/icon38.png"
    }
  },
  "side_panel": {
    "default_path": "reader/reader.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "style/bubble.css"
      ],
      "js": [
        "lib/Readability.min.js",
        "utils/truncatedHtml.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "summary.html",
        "content.html",
        "style/*",
        "lib/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "sidePanel",
    "offscreen"
  ],
  "host_permissions": [
    "https://api.openai.com/*"
  ],
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}